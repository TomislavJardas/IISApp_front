<Window x:Class="IISApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="IIS Frontend Dashboard" Height="520" Width="920">
    <Grid Margin="24">
        <Border Style="{StaticResource CardPanelStyle}" MaxWidth="520" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="IIS Frontend" Style="{StaticResource SectionTitleStyle}" HorizontalAlignment="Center"/>
                <TextBlock Text="Choose a feature window" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                <Button x:Name="OpenLoginWindowButton" Content="Login" Click="OpenLoginWindowButton_Click"/>
                <Button x:Name="OpenPlayersWindowButton" Content="REST Players" Click="OpenPlayersWindowButton_Click"/>
                <Button x:Name="OpenGraphQlWindowButton" Content="GraphQL Players" Click="OpenGraphQlWindowButton_Click"/>
                <Button x:Name="OpenSOAPWindowButton" Content="SOAP Players" Click="OpenSOAPWindowButton_Click"/>
                <Button x:Name="OpenXRPCWindowBUtton" Content="Weather (gRPC)" Click="OpenXRCPWindowButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
